{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "../../..",
    "paths": {
      "@vivlos/infra/eventbus/index.ts": ["vivlos/infra/eventbus/index.ts"],
      "@vivlos/infra/eventbus/*": ["vivlos/infra/eventbus/*"],
      "@vivlos/agent/types.ts": ["vivlos/agent/types.ts"],
      "@vivlos/agent/*": ["vivlos/agent/*"],
      "@vivlos/*": ["vivlos/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../../vivlos/**/*.ts"],
  "exclude": ["node_modules"]
}
