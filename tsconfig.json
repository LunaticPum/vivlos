{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"outDir": "dist",
		"rootDir": ".",
		"baseUrl": ".",
		"paths": {
			"@vivlos/shared": ["vivlos/shared/index.ts"],
			"@vivlos/shared/*": ["vivlos/shared/*"],
			"@vivlos/agent": ["vivlos/agent/index.ts"],
			"@vivlos/agent/*": ["vivlos/agent/*"],
			"@vivlos/infra": ["vivlos/infra/index.ts"],
			"@vivlos/infra/*": ["vivlos/infra/*"],
			"@vivlos/entries": ["vivlos/entries/index.ts"],
			"@vivlos/entries/*": ["vivlos/entries/*"],
			"@vivlos/*": ["vivlos/*"],
			"@earendil-works/pi-ai": ["packages/ai/src/index.ts"],
			"@earendil-works/pi-ai/*": ["packages/ai/src/*"],
			"@earendil-works/pi-agent-core": ["packages/agent/src/index.ts"],
			"@earendil-works/pi-agent-core/*": ["packages/agent/src/*"],
			"@earendil-works/pi-tui": ["packages/tui/src/index.ts"],
			"@earendil-works/pi-tui/*": ["packages/tui/src/*"],
			"@earendil-works/pi-ai/providers/all": ["packages/ai/src/providers/all"]
		}
	},
	"include": ["vivlos/**/*.ts"],
	"exclude": ["node_modules", "packages"]
}
