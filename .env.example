# ── LLM Provider API Keys ──
# 按需填写你使用的 provider 的 key
# 命名规则：${PROVIDER大写}_API_KEY
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key

# ── 默认 LLM 配置 ──
VIVLOS_DEFAULT_PROVIDER=deepseek
VIVLOS_DEFAULT_MODEL=deepseek-v4-flash

# ── Tavily Web Search（可选）──
# 安装 tvly CLI 后使用 web 搜索相关 skill
# 安装：curl -fsSL https://cli.tavily.com/install.sh | bash
# 认证：tvly login --api-key tvly-YOUR_KEY
# 或通过此环境变量自动认证：
# TAVILY_API_KEY=tvly-your-key

# ── 路径覆盖（可选，默认 .vivlos/ 在 cwd 下）──
# VIVLOS_DB_PATH=.vivlos/vivlos.db
# VIVLOS_LOG_DIR=.vivlos/logs
